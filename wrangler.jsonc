{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bloomcore-technologies-page",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      // Production D1 database, created by the owner in the Cloudflare dashboard.
      "database_name": "bloomcore-leads-prod",
      "database_id": "97c348f1-57b6-41cb-8d1c-33ea1b6c4955",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "LEADS_ENVIRONMENT": "production",
    "DASHBOARD_ORIGIN": "https://bloomcoretech.com",
    "LEAD_NOTIFICATION_EMAIL": "bloomcoretechnologies@gmail.com",
    "EMAIL_FROM": "BloomCore Technologies <notifications@notify.bloomcoretech.com>",
    "EMAIL_REPLY_TO": "bloomcoretechnologies@gmail.com",
    "INTERNAL_ALLOWED_EMAILS": "bloomcoretechnologies@gmail.com",
    // The owner role. Add every owner address here; they need no staff row.
    "LEAD_OWNER_EMAILS": "bloomcoretechnologies@gmail.com",
    // Cloudflare Access. One audience per Access application: dashboard vs internal API.
    // Team domain discovered from the live Access login redirect.
    "CF_ACCESS_TEAM_DOMAIN": "https://red-boat-3eb2.cloudflareaccess.com",
    "CF_ACCESS_AUD_INTERNAL": "e539cbafaba15f541c87c642f59101df19ef50b568e85d6b418be6c3f61af72b",
    "CF_ACCESS_AUD_API": "3ce614a6d610b892ffc0ff9ccedc07525c12e251c0373d5f9cf2adf917ffd991"
  },
  "services": [
    {
      // Self-reference service binding. The service name must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bloomcore-technologies-page"
    }
  ],
  "observability": {
    "enabled": true
  }
}
