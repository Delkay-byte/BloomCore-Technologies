{
  "name": "bloomcore-technologies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/helpers/register.mjs --test tests/domain.test.ts tests/access-auth.test.ts tests/filters.test.ts tests/datetime.test.ts tests/tracking.test.ts tests/patch.test.ts tests/console-routing.test.ts tests/d1-repository.test.ts tests/notifications.test.ts tests/permissions.test.ts tests/staff.test.ts tests/assignment.test.ts tests/numbering.test.ts tests/scoping.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply LEADS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply LEADS_DB --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "motion": "^14.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.160.0"
  },
  "description": "Corporate website for BloomCore Technologies."
}
