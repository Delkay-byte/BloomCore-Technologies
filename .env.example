# The canonical production origin is https://bloomcoretech.com and is set in
# src/lib/site.ts. NEXT_PUBLIC_SITE_URL is optional and used only for a genuine
# staging origin. Localhost, preview and *.netlify.app values are ignored so
# canonical metadata cannot drift.

# Google Search Console verification token (HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Tag Manager container GTM-TQK7FMJT is installed in source and loads
# only after the visitor allows analytics. The GA4 Google tag lives inside the
# container, so no GA4 measurement ID environment variable is needed.
